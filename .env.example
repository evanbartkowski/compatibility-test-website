# Brand Configuration
# NEXT_PUBLIC_BRAND_NAME=Truth Desire
# NEXT_PUBLIC_APP_URL=https://truthdesire.app

# Firebase Project (truth-desire) Client SDK
# NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=truth-desire.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=truth-desire
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=truth-desire.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=963833977494
# NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
# NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false
# Optional extra Firestore user profiles. Enable only with a provisioned database and deployed owner rules.
# Firebase accounts and the app's private result repository work without this.
# NEXT_PUBLIC_FIREBASE_PROFILE_SYNC_ENABLED=false
# Only expose Google sign-in after enabling and configuring that provider.
# NEXT_PUBLIC_GOOGLE_SIGNIN_ENABLED=false

# Optional Transactional Email Delivery (Resend or SMTP)
# RESEND_API_KEY=re_xxxxxxxxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-smtp-password
# EMAIL_FROM="Truth Desire <noreply@truthdesire.app>"

# Protected Admin Console & Studio Authentication Passphrase (min 8 chars; required in production)
# BETWEEN_US_ADMIN_KEY=replace-with-strong-admin-passphrase

# Private account cookie signing key: at least 32 random characters, separate from admin key.
# BETWEEN_US_UID_SECRET=replace-with-an-independent-long-random-secret
# Production requires an absolute path on a persistent private volume, with one Node writer.
# BETWEEN_US_DATA_DIR=/var/lib/truth-desire
# Local emulator testing only; never point these at real production infrastructure.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Local Playwright HTTP verification override (only set during local http://127.0.0.1 builds)
# ALLOW_HTTP_LOCALHOST=true
